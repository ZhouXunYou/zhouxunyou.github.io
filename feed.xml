---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ page_lang | default: 'zh' }}">
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" hreflang="{{ page_lang | default: 'zh' }}" />
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url }}</id>
  <title type="html">{{ site.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
  <subtitle>{{ site.description | normalize_whitespace | xml_escape }}</subtitle>
  <author>
    <name>{{ site.author | default: site.github_username | xml_escape }}</name>
  </author>

  {% assign page_lang_val = page_lang | default: 'zh' %}

  {% for post in site.posts limit:20 %}
  <entry>
    <title type="html">{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" hreflang="{{ post.lang | default: 'zh' }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post.url | absolute_url }}</id>
    <content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | strip | xml_escape }}</content>
    <author><name>{{ post.author | default: site.author | xml_escape }}</name></author>
    {% for cat in post.categories %}
    <category term="{{ cat | xml_escape }}" />
    {% endfor %}
  </entry>
  {% endfor %}

  {% for project in site.projects limit:50 %}
  {% if project.lang == page_lang_val %}
  <entry>
    <title type="html">{{ project.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
    <link href="{{ project.url | absolute_url }}" rel="alternate" type="text/html" hreflang="{{ project.lang | default: 'zh' }}" />
    <published>{{ project.date | default: site.time | date_to_xmlschema }}</published>
    <updated>{{ project.last_modified_at | default: site.time | date_to_xmlschema }}</updated>
    <id>{{ project.url | absolute_url }}</id>
    {% if project.description %}
    <summary type="html">{{ project.description | normalize_whitespace | xml_escape }}</summary>
    {% endif %}
    <content type="html" xml:base="{{ project.url | absolute_url }}">{{ project.content | strip | xml_escape }}</content>
    {% if project.category %}
    <category term="{{ project.category | xml_escape }}" />
    {% endif %}
  </entry>
  {% endif %}
  {% endfor %}
</feed>
