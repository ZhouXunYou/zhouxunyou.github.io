---
layout: null
permalink: /search.json
---
[
  {% assign search_pages = site.projects | where_exp: "p", "p.title" %}
  {% for page in search_pages %}
  {
    "title": {{ page.title | jsonify }},
    "category": {{ page.category | jsonify }},
    "lang": {{ page.lang | default: "zh" | jsonify }},
    "url": {{ page.url | jsonify }},
    "type": "project",
    "content": {{ page.content | strip_html | strip_newlines | normalize_whitespace | truncate: 3000 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% for page in site.posts %}
  ,{
    "title": {{ page.title | jsonify }},
    "category": {{ page.category | default: page.categories | first | jsonify }},
    "lang": {{ page.lang | default: "zh" | jsonify }},
    "url": {{ page.url | jsonify }},
    "type": "post",
    "content": {{ page.content | strip_html | strip_newlines | normalize_whitespace | truncate: 3000 | jsonify }}
  }
  {% endfor %}
  {% for page in site.html_pages %}
  {% if page.title and page.layout != 'default' %}
  ,{
    "title": {{ page.title | jsonify }},
    "category": {{ page.category | jsonify }},
    "lang": {{ page.lang | default: "zh" | jsonify }},
    "url": {{ page.url | jsonify }},
    "type": "page",
    "content": {{ page.content | strip_html | strip_newlines | normalize_whitespace | truncate: 2000 | jsonify }}
  }
  {% endif %}
  {% endfor %}
]
